# Copy this file to .env.local and fill in your own credentials.
# Never commit real secrets to this template.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET
# Generate locally with: openssl rand -hex 32
AUTH0_SECRET=YOUR_GENERATED_AUTH0_SECRET

# Optional: media extraction and answers. Never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Enabling sends selected text and queries to Google.
ENABLE_GEMINI_EMBEDDINGS=true

# Supabase Storage (server-only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Paste your provider's PostgreSQL connection URL here.
# URL-encode password characters; set sslrootcert to your trusted CA file if needed.
DATABASE_URL=

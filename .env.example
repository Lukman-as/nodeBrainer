APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate locally with: openssl rand -hex 32
AUTH0_SECRET=
# Tiger Cloud PostgreSQL connection string; server certificate verification is enforced.
DATABASE_URL=
# Optional: media extraction and semantic search. Never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Enabling sends note passages and queries to Google. Re-save notes to embed older content.
ENABLE_GEMINI_EMBEDDINGS=false

APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate locally with: openssl rand -hex 32
AUTH0_SECRET=
# PostgreSQL connection string; server certificate verification is enforced.
# Supabase: use the pooler URL and append &sslrootcert=db/supabase-ca.pem (download from Database settings).
DATABASE_URL=
# Supabase Storage for uploaded files (Project settings > API). Server-only; never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: media extraction and semantic search. Never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEY=
# Comma-separated; on quota (429), unavailable (404) or overloaded (503) the next model is tried.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Enabling sends note passages and queries to Google. Re-save notes to embed older content.
ENABLE_GEMINI_EMBEDDINGS=false
